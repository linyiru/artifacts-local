{
  "name": "artifacts-hello",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Production: the real binding.
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "default" }],
  "env": {
    // `wrangler dev -e local -c wrangler.jsonc -c ../../worker/wrangler.jsonc`
    // swaps the binding for the artifacts-local shim; the app code does not change.
    "local": {
      "services": [
        {
          "binding": "ARTIFACTS",
          "service": "artifacts-local-shim",
          "entrypoint": "ArtifactsLocal",
          "props": { "namespace": "default" },
        },
      ],
      // Production would subscribe this queue to Artifacts events; locally the shim feeds it.
      "queues": { "consumers": [{ "queue": "artifacts-events", "max_batch_timeout": 1 }] },
      "kv_namespaces": [{ "binding": "RECEIVED", "id": "local-received" }],
    },
  },
}
