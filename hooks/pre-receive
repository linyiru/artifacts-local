#!/bin/sh
# Reject pushes that carry a file larger than the Artifacts per-file limit (32 MB), or that would
# grow the repository past its limit (1 GB). artifacts-local sets both limits for each push.
max=${ARTIFACTS_MAX_BLOB_BYTES:-33554432}
max_repo=${ARTIFACTS_MAX_REPO_BYTES:-1073741824}
zero=0000000000000000000000000000000000000000
while read -r old new ref; do
  [ "$new" = "$zero" ] && continue
  if [ "$old" = "$zero" ]; then
    objects=$(git rev-list --objects "$new" --not --all)
  else
    objects=$(git rev-list --objects "$old..$new")
  fi
  big=$(printf '%s\n' "$objects" |
    git cat-file --batch-check='%(objecttype) %(objectsize) %(objectname) %(rest)' |
    awk -v max="$max" '$1 == "blob" && $2 > max { print $3 " " $2 " " $4; exit }')
  if [ -n "$big" ]; then
    set -- $big
    echo "error: $3 ($2 bytes) exceeds the Artifacts limit of $max bytes per file" >&2
    exit 1
  fi
done
# Incoming objects sit in a quarantine directory under objects/, so this counts the push too.
size=$(( $(du -sk "${GIT_DIR:-.}/objects" | cut -f1) * 1024 ))
if [ "$size" -gt "$max_repo" ]; then
  echo "error: this push would grow the repository to about $size bytes, over the Artifacts limit of $max_repo bytes" >&2
  exit 1
fi
exit 0
