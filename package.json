{
  "name": "artifacts-local",
  "version": "0.3.0",
  "private": true,
  "description": "Local emulator for Cloudflare Artifacts: REST control plane, Git smart HTTP, and a Workers binding shim.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "artifacts-local": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "hooks",
    "worker",
    "SPEC.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node src/cli.ts serve",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "test:contract": "vitest run test/contract",
    "test:live": "ARTIFACTS_LIVE=1 vitest run test/contract",
    "e2e": "scripts/e2e-wrangler.sh",
    "record": "node scripts/record.ts",
    "build": "tsdown",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "tsc --noEmit && oxlint --deny-warnings && oxfmt --check && tsdown --logLevel warn && git diff --exit-code -- dist"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "4.1.11",
    "isomorphic-git": "1.42.2",
    "miniflare": "5.20260921.0-alpha",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "publint": "0.3.24",
    "rolldown": "1.2.10",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "rolldown": "1.2.10"
  }
}
