{
  "name": "artifacts-local",
  "version": "0.1.0",
  "private": true,
  "description": "Local emulator for Cloudflare Artifacts: REST control plane, Git smart HTTP, and a Workers binding shim.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "artifacts-local": "./src/cli.ts"
  },
  "scripts": {
    "start": "node src/cli.ts serve",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
